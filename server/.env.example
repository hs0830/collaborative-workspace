# ─────────────────────────────────────────────
# 서버 환경변수 예시. 이 파일을 .env 로 복사해서 값을 채우세요.
# Render 에서는 대시보드 → Environment 에 같은 이름으로 넣으면 됩니다.
# 값을 비워 두면 개발 모드(메모리 저장, 로컬 디스크 업로드)로 동작합니다.
# ─────────────────────────────────────────────

# 서버 포트 (Render 는 자동으로 넣어줌)
PORT=4000

# 접속을 허용할 프론트엔드 주소 (쉼표로 여러 개)
CLIENT_ORIGIN=http://localhost:3000

# 배포 시 production 으로 설정 → 아래 TEAM_INVITE_CODE, AUTH_SECRET 이 없으면 서버가 시작되지 않음
NODE_ENV=development

# ── 로그인 ──
# 팀원에게 공유할 초대 코드
TEAM_INVITE_CODE=
# 로그인 토큰 서명용 비밀값 (아무 긴 무작위 문자열). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── DB: Supabase ──
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
# 예: postgresql://postgres.abcdefgh:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── 파일 저장소: Cloudflare R2 ──
# Cloudflare → R2 → 버킷 생성 → "Manage R2 API Tokens" 에서 Object Read & Write 토큰 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 이 서버의 공개 주소 (R2 를 쓰지 않을 때 다운로드 링크에 사용)
PUBLIC_SERVER_URL=http://localhost:4000
